# ==============================================================================
# YukLa — Production Environment Configuration (.env.example)
# Google Cloud Run + Cloud SQL + Redis + Escrow & FinTech Payment Gateways
# ==============================================================================

# Core Application Settings
PORT=3000
NODE_ENV="production"
APP_URL="https://yukla.uz"

# Gemini AI Engine (Logistics Dispatcher, Route Optimization, Pricing Intelligence)
GEMINI_API_KEY=""

# PostgreSQL / Google Cloud SQL Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://yukla_admin:SecurePass2026@localhost:5432/yukla_production?schema=public"
CLOUD_SQL_CONNECTION_NAME="yukla-production:asia-southeast1:yukla-postgres-main"

# Redis Cache & Distributed Locking (Idempotent Escrow Payout Engine)
REDIS_URL="redis://default:SecureRedisPass@localhost:6379"

# Security & Session Authentication
JWT_SECRET="replace_with_high_entropy_jwt_secret_minimum_32_chars"
REFRESH_SECRET="replace_with_high_entropy_refresh_secret_minimum_32_chars"
COOKIE_SECRET="replace_with_cookie_signing_secret"

# SMS OTP Gateways (Uzbekistan +998 Carriers: PlayMobile & Eskiz)
SMS_PROVIDER="playmobile" # playmobile | eskiz
PLAYMOBILE_ORIGINATOR="YukLa"
PLAYMOBILE_API_URL="https://api.playmobile.uz/broker-api"
PLAYMOBILE_USERNAME=""
PLAYMOBILE_PASSWORD=""
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""

# Escrow Billing & Payment Gateways
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="false"

CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

UZUM_MERCHANT_ID=""
UZUM_SECRET_KEY=""

# 99% Card-to-Card Instant Payout Engine (Uzcard / Humo Direct Gateway)
UZCARD_PAYOUT_ENDPOINT="https://payout.uzcard.uz/api/v2/disburse"
UZCARD_PAYOUT_API_KEY=""
HUMO_PAYOUT_ENDPOINT="https://payout.humo.uz/api/v1/payout"
HUMO_PAYOUT_API_KEY=""

# Electronic Document Turnover (Didox E-Faktura & E-TTN 1-Click Integration)
DIDOX_API_URL="https://api.didox.uz/v1"
DIDOX_API_KEY=""

# Google Maps Platform (Server-Side Proxy with solution_id)
GOOGLE_MAPS_API_KEY=""

# Google Cloud Storage (Driver KYC Documents: License, Tex Passport, Vehicle Photos)
GCS_BUCKET_NAME="yukla-kyc-storage-prod"
GCS_PROJECT_ID="yukla-production"
GCS_CREDENTIALS_JSON=""

# SaaS Subscription Pricing (UZS / month)
SUBSCRIPTION_ODDIY_PRICE=0
SUBSCRIPTION_PRO_PRICE=149000
SUBSCRIPTION_VIP_PRICE=299000
ESCROW_COMMISSION_PERCENT=1.0
